APP_NAME=AIGC Interactive Character Simulator
DATABASE_URL=sqlite:///./aigc_character_simulator.db

# Text provider defaults
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TEMPERATURE=0.8
DEEPSEEK_MAX_TOKENS=500
DEEPSEEK_THINKING_ENABLED=true
DEEPSEEK_REASONING_EFFORT=high

# Character image generation
MEDIA_DIR=./media
PUBLIC_BASE_URL=http://127.0.0.1:8000
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1
IMAGE_GENERATION_PATH=/images/generations
IMAGE_EDIT_PATH=/images/edits
IMAGE_QUALITY=medium
IMAGE_SIZE=1024x1024
IMAGE_BACKGROUND=opaque
IMAGE_INPUT_FIDELITY=high
